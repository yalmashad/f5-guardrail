# F5 AI Security Guardrails PoC automation config.
# Copy to config/guardrails-poc.env and adjust if needed.
#
# Secrets can be supplied either through files or environment variables:
# - Harbor credentials file format: first non-empty line is username, second is password.
# - License file format: entire file content is the license string.
# - Environment override variables: HARBOR_USERNAME, HARBOR_PASSWORD, F5_LICENSE_STRING.

AWS_REGION="us-east-1"
CLUSTER_NAME="f5-guardrails-poc"
K8S_VERSION="1.35"

NODEGROUP_NAME="guardrails-gpu-ng"
NODE_TYPE="g5.4xlarge"
NODE_COUNT="1"
NODE_MIN="1"
NODE_MAX="1"
NODE_VOLUME_SIZE="150"
NODE_AMI_FAMILY="AmazonLinux2023"
VPC_NAT_MODE="Disable"

HOSTNAME="guardrails.f5demo.io"
ROUTE53_ZONE_NAME="f5demo.io"
ROUTE53_HOSTED_ZONE_ID="Z01552491KU67A60QQPXC"

# Initial Guardrails UI credentials from the F5 runbook.
# These are shown in the deployment/status summary for first login only.
GUARDRAILS_DEFAULT_USERNAME="admin"
GUARDRAILS_DEFAULT_PASSWORD="pass"

# Keycloak realms where users may need to rotate the initial password.
# Passwords are realm-specific.
GUARDRAILS_AUTH_REALMS="master calypsoai"

HARBOR_REGISTRY="harbor.calypsoai.app"
HARBOR_CREDENTIALS_FILE="config/harbor.txt"
F5_LICENSE_FILE="config/license.txt"

F5_NAMESPACE="f5-ai-sec"
MODERATOR_NAMESPACE="cai-moderator"
PREFECT_NAMESPACE="prefect"
INFERENCE_NAMESPACE="f5-ai-sec-inference"
INGRESS_NAMESPACE="ingress-nginx"

OPERATOR_RELEASE="f5-ai-security-operator"
OPERATOR_CHART="oci://harbor.calypsoai.app/calypsoai/f5-ai-security-operator-helm"
OPERATOR_CHART_VERSION="1.4.1"

INGRESS_RELEASE="ingress-nginx"
INGRESS_CHART="ingress-nginx/ingress-nginx"
INGRESS_REPO_NAME="ingress-nginx"
INGRESS_REPO_URL="https://kubernetes.github.io/ingress-nginx"

SECURITY_OPERATOR_NAME="security-operator-demo"
POSTGRES_STORAGE_CLASS="gp2"
POSTGRES_PASSWORD_FILE=".secrets/postgres-password"

# Set to "true" if you want the script to regenerate the self-signed certificate on each up run.
RECREATE_TLS_SECRET="false"

# Delete available EBS volumes still tagged as owned by this PoC cluster after teardown.
# This catches in-cluster PostgreSQL PVC volumes left behind by the CSI driver.
CLEANUP_LEFTOVER_EBS_VOLUMES="true"
